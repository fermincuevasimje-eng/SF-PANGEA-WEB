# COPIA este archivo como .streamlit/secrets.toml (local) y pega su contenido
# en Streamlit Cloud > Settings > Secrets. NUNCA subas secrets.toml a GitHub.
# Cambia TODAS las contraseñas por valores nuevos y distintos: las anteriores
# estaban en el repo público y deben considerarse comprometidas.

[users]
SF = "CAMBIA-CONTRASEÑA-SF-UNICA"
Director = "CAMBIA-CONTRASEÑA-DIRECTOR-UNICA"
GuaDAP = "CAMBIA-CONTRASEÑA-GUADAP-UNICA"
Edith = "CAMBIA-CONTRASEÑA-EDITH-UNICA"
"Jefe Mant." = "CAMBIA-CONTRASEÑA-JEFEMANT-UNICA"
"Jefe Infra." = "CAMBIA-CONTRASEÑA-JEFEINFRA-UNICA"
"Almacén 1" = "CAMBIA-CONTRASEÑA-ALMACEN1-UNICA"
"Almacén 2" = "CAMBIA-CONTRASEÑA-ALMACEN2-UNICA"
"DAP 1" = "CAMBIA-CONTRASEÑA-DAP1-UNICA"
"DAP 2" = "CAMBIA-CONTRASEÑA-DAP2-UNICA"
"DAP 3" = "CAMBIA-CONTRASEÑA-DAP3-UNICA"
"Brigada 1" = "CAMBIA-CONTRASEÑA-BRIGADA1-UNICA"
"Brigada 2" = "CAMBIA-CONTRASEÑA-BRIGADA2-UNICA"
"Brigada 3" = "CAMBIA-CONTRASEÑA-BRIGADA3-UNICA"
"Brigada 4" = "CAMBIA-CONTRASEÑA-BRIGADA4-UNICA"
"Brigada 5" = "CAMBIA-CONTRASEÑA-BRIGADA5-UNICA"
"Brigada 6" = "CAMBIA-CONTRASEÑA-BRIGADA6-UNICA"
"Brigada 7" = "CAMBIA-CONTRASEÑA-BRIGADA7-UNICA"
"Brigada 8" = "CAMBIA-CONTRASEÑA-BRIGADA8-UNICA"
"Brigada 9" = "CAMBIA-CONTRASEÑA-BRIGADA9-UNICA"
"Brigada 10" = "CAMBIA-CONTRASEÑA-BRIGADA10-UNICA"
"Brigada 11" = "CAMBIA-CONTRASEÑA-BRIGADA11-UNICA"
"Brigada 12" = "CAMBIA-CONTRASEÑA-BRIGADA12-UNICA"
"Brigada 13" = "CAMBIA-CONTRASEÑA-BRIGADA13-UNICA"
"Brigada 14" = "CAMBIA-CONTRASEÑA-BRIGADA14-UNICA"
"Brigada 15" = "CAMBIA-CONTRASEÑA-BRIGADA15-UNICA"
"Brigada 16" = "CAMBIA-CONTRASEÑA-BRIGADA16-UNICA"
"Brigada 17" = "CAMBIA-CONTRASEÑA-BRIGADA17-UNICA"
"Especial 1" = "CAMBIA-CONTRASEÑA-ESPECIAL1-UNICA"
"Especial 2" = "CAMBIA-CONTRASEÑA-ESPECIAL2-UNICA"
"Especial 3" = "CAMBIA-CONTRASEÑA-ESPECIAL3-UNICA"

[pins]
maestro = "CAMBIA-PIN-MAESTRO-NUEVO"
almacen = "CAMBIA-PIN-ALMACEN-NUEVO"

# Las secciones [supabase] y [connections.gsheets] ya existían en tus Secrets:
# consérvalas tal cual al pegar este contenido, no las borres.

# NUEVO (Panel Admin con llave de servicio): en tu sección [supabase] YA
# EXISTENTE, agrega esta línea con tu llave service_role de Supabase
# (Supabase Studio -> Settings -> API -> service_role). Nunca la pegues
# en el chat ni la subas a GitHub.
# SUPABASE_SERVICE_KEY = "PEGA-AQUI-TU-LLAVE-SERVICE-ROLE"
